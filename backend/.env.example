# Proveedores soportados: kev, jev, groq o none. La producción los mantiene apagados
# hasta la aprobación expresa del cliente; no hay selección automática de respaldo.
# El modo demo permite fixtures locales. Producción requiere PostgreSQL; OIDC es opcional.
VIGILIA_MODE=demo
VIGILIA_SEED_DEMO=true
DATABASE_URL=

# OIDC (opcional). Define las cuatro OIDC_* o ninguna. Sin OIDC, el primer administrador
# se crea con: python -m app.bootstrap_admin --id ADMIN-01 --name "Nombre Apellido"
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_FRONTEND_ORIGIN=
VIGILIA_SESSION_SECRET=
VIGILIA_BOOTSTRAP_ADMIN_EMAIL=
VIGILIA_SESSION_SAME_SITE=lax

# Clave Fernet creada por TI en la infraestructura del cliente.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGILIA_SECRET_ENCRYPTION_KEY=

# Desactivada por defecto; producción requiere aprobación documentada.
VIGILIA_AI_PROVIDER=none
VIGILIA_AI_APPROVED=false
VIGILIA_RULES_FALLBACK=false

# Proveedores y modelos: cada persona los configura en Configuración de IA (página personal).
# Las claves se guardan cifradas en la base de datos con la clave Fernet anterior.
# Ollama local se resuelve desde el servidor, no desde el navegador del usuario.
VIGILIA_OLLAMA_URL=http://127.0.0.1:11434

# Kev se ejecuta aparte y puede alojarse en una máquina privada.
# Deja KEV_API_URL vacío para marcar el análisis como pendiente.
KEV_API_URL=
KEV_API_KEY=
KEV_MODEL=kev-latest
KEV_MIN_PROBABILITY=0.75
KEV_TIMEOUT_SECONDS=8

# Solo se usa si VIGILIA_AI_PROVIDER=groq. Nunca poner claves en variables VITE_*.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8

# Jev usa el endpoint de evaluación del AI Gateway. La ruta exige ZDR para procesar
# ingresos reales y falla cerrada si el Gateway no puede garantizarlo.
# disallowPromptTraining no sustituye ZDR.
AI_GATEWAY_API_KEY=
JEV_TIMEOUT_SECONDS=8

# Variables privadas del backend.
VIGILIA_KEY=
VIGILIA_DB=
VIGILIA_CORS_ORIGINS=http://127.0.0.1:5173
SLACK_ENABLED=false
SLACK_WEBHOOK_ADMISIONES=
SLACK_WEBHOOK_GESTOR=

# Optional private OAuth subscription connector (services/ai-subscriptions).
# Configure a private password through your deployment secret manager.
VIGILIA_OPENCODE_URL=http://127.0.0.1:4096
VIGILIA_OPENCODE_PASSWORD=
# Connector process only: absolute private persistent path outside the repository.
VIGILIA_SUBSCRIPTIONS_DATA_DIR=
VIGILIA_OPENCODE_PORT=4096
# Personal OAuth broker capacity. Never share an account store across workers/users.
VIGILIA_SUBSCRIPTIONS_MAX_WORKERS=12
# Explicit opt-in to the operator-managed shared Ollama daemon.
VIGILIA_ALLOW_SHARED_OLLAMA=false

# --- Instalaciones de evaluación (hackIAthon). Una instalación real no las define. ---
# Generadas con: node scripts/credenciales-jurado.mjs (ver docs/entrega-jurado.md).
# IA compartida del equipo, guardada cifrada y activa en demo-admin y en las cuentas del jurado.
VIGILIA_SHARED_AI_PROVIDER=ollama
VIGILIA_SHARED_AI_MODEL=gpt-oss:20b
VIGILIA_SHARED_AI_KEY=
# Cuenta cuya IA clasifica el webhook en modo demo.
VIGILIA_DEMO_AI_OWNER=demo-admin
# Producción: modo Demo dentro de la misma instalación (cuenta sin credenciales; el webhook
# acepta VIGILIA_KEY con el contrato canónico).
VIGILIA_DEMO_ACCESS=false
# Opcional: enlaces del selector si Demo y Producción se despliegan por separado.
VIGILIA_DEMO_URL=
VIGILIA_PRODUCTION_URL=
# Producción de muestra: aseguradora y receptores de avisos simulados.
VIGILIA_SIMULATED_SYSTEMS=false
VIGILIA_SIMULATED_BASE_URL=
# Producción de muestra: cuentas y token fijos del jurado (se restablecen al arrancar).
VIGILIA_JURY_ADMIN_PASSWORD=
VIGILIA_JURY_ADMIN_TOTP=
VIGILIA_JURY_EMPLOYEE_TOTP=
VIGILIA_JURY_INGRESS_TOKEN=
# Segundos tras los que un evento que quedó en proceso puede reintentarse.
VIGILIA_STALE_SECONDS=120
