# URL pública del servicio FastAPI. Déjala vacía mientras no haya un servicio configurado.
VITE_API_BASE_URL=

# Control visual para habilitar el formulario de ingreso en esta instalación.
# No reemplaza autenticación, permisos ni validaciones implementadas por el backend.
VITE_LIVE_INGRESS_ENABLED=false

# Prueba sintética de Jev: exigir ZDR en AI Gateway y permitir solo TypeSafe AI.
# Variable privada del servidor, nunca usar VITE_ ni activarla sin validar el acceso ZDR.
JEV_SYNTHETIC_REQUIRE_ZDR=false
