# Proveedores soportados: kev, jev, groq o none. La producción los mantiene apagados
# hasta la aprobación expresa del cliente; no hay selección automática de respaldo.
# El modo demo permite fixtures locales. Producción requiere PostgreSQL y OIDC.
VIGILIA_MODE=demo
VIGILIA_SEED_DEMO=true
DATABASE_URL=

# OIDC (producción). El administrador inicial debe tener el correo verificado.
OIDC_DISCOVERY_URL=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=
OIDC_FRONTEND_ORIGIN=
VIGILIA_SESSION_SECRET=
VIGILIA_BOOTSTRAP_ADMIN_EMAIL=
VIGILIA_SESSION_SAME_SITE=lax

# Clave Fernet creada por TI en la infraestructura del cliente.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VIGILIA_SECRET_ENCRYPTION_KEY=

# Desactivada por defecto; producción requiere aprobación documentada.
VIGILIA_AI_PROVIDER=none
VIGILIA_AI_APPROVED=false
VIGILIA_RULES_FALLBACK=false

# Kev se ejecuta aparte y puede alojarse en una máquina privada.
# Deja KEV_API_URL vacío para marcar el análisis como pendiente.
KEV_API_URL=
KEV_API_KEY=
KEV_MODEL=kev-latest
KEV_MIN_PROBABILITY=0.75
KEV_TIMEOUT_SECONDS=8

# Solo se usa si VIGILIA_AI_PROVIDER=groq. Nunca poner claves en variables VITE_*.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=8

# Jev usa el endpoint de evaluación del AI Gateway. La ruta exige ZDR para procesar
# ingresos reales y falla cerrada si el Gateway no puede garantizarlo.
# disallowPromptTraining no sustituye ZDR.
AI_GATEWAY_API_KEY=
JEV_TIMEOUT_SECONDS=8

# Variables privadas del backend.
VIGILIA_KEY=
VIGILIA_DB=
VIGILIA_CORS_ORIGINS=http://127.0.0.1:5173
SLACK_ENABLED=false
SLACK_WEBHOOK_ADMISIONES=
SLACK_WEBHOOK_GESTOR=
